{
  "name": "Despam",
  "version": "1.0.0",
  "main": "main.js",
  "scripts": {
    "start": "concurrently \"npm run start-react\" \"npm run start-electron\"",
    "start-react": "cd frontend && npm start",
    "start-electron": "electron .",
    "build": "cd frontend && npm run build && cd .. && electron-builder"
  },
  "build": {
    "appId": "com.yourapp.name",
    "productName": "Despam",
    "files": [
      "frontend/build/**/*",
      "main.js",
      "assets",
      "gmailAPI.js",
      "credentials.json",
      "preload.js",
      "webviewPreload.js",
      "keywords.js"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "assets/icon.ico"
    },
    "extraResources": [
      {
        "from": "credentials.json",
        "to": "credentials.json"
      },
      {
        "from": "keywords.js",
        "to": "keywords.js"
      }
    ]
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "axios": "^1.7.8",
    "concurrently": "^9.1.0",
    "express": "^4.21.1",
    "googleapis": "^144.0.0",
    "json5": "^2.2.3",
    "wait-on": "^8.0.1"
  }
}
